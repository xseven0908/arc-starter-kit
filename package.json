{
  "name": "arc-starter-kit",
  "version": "0.2.0",
  "private": true,
  "description": "Full-stack reference starter kit for deploying, testing, and monitoring payment, escrow, yield-vault, and FX PvP contracts on Arc Testnet (Circle's stablecoin-native L1)",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "typecheck": "tsc --noEmit",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.ts --network arcTestnet",
    "deploy:invoice": "hardhat run scripts/deploy-invoice.ts --network arcTestnet",
    "deploy:escrow": "hardhat run scripts/deploy-escrow.ts --network arcTestnet",
    "deploy:savings": "hardhat run scripts/deploy-savings-pool.ts --network arcTestnet",
    "deploy:fx": "hardhat run scripts/deploy-fx-pvp.ts --network arcTestnet",
    "watch": "tsx scripts/watch-events.ts",
    "send": "tsx scripts/send-payment.ts",
    "balance": "tsx scripts/unified-balance.ts",
    "bridge": "tsx scripts/bridge-payment.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "^1.17.0",
    "@circle-fin/app-kit": "^1.13.0",
    "@circle-fin/bridge-kit": "^1.14.0",
    "viem": "^2.21.0"
  }
}
