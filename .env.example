# Deployer private key (must hold testnet USDC for gas — get some from https://faucet.circle.com)
PRIVATE_KEY=

# Arc Testnet RPC endpoint (default shown; alternates listed in README)
ARC_RPC_URL=https://rpc.testnet.arc.io

# Filled in after `npm run deploy`
CONTRACT_ADDRESS=

# App Kit send demo (scripts/send-payment.ts) — any recipient address, and a small amount
RECIPIENT_ADDRESS=
SEND_AMOUNT=0.10
